{# Variables attendues : url, label #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:28px auto;">
    <tr>
        <td align="center" bgcolor="#E50914" style="background-color:#E50914;border-radius:12px;">
            <a
                href="{{ url }}"
                target="_blank"
                style="display:inline-block;padding:14px 32px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:#FFFFFF;text-decoration:none;border-radius:12px;"
            >
                {{ label }}
            </a>
        </td>
    </tr>
</table>
